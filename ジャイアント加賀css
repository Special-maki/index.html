/*
 * ファイル名: ジャイアント加賀.css
 * 適用対象: index.html
 * 目的: H1とH2要素を含む基本的なスタイルの定義
 */

/* ------------------------------------------- */
/* ページ全体（body）の基本設定 */
/* ------------------------------------------- */
body {
    /* 標準的なフォントを指定し、読みやすくします */
    font-family: 'メイリオ', 'Hiragino Kaku Gothic Pro', sans-serif;
    /* ページの上下左右の余白をなくします */
    margin: 0;
    padding: 0;
    /* 背景色を白に近い色にします */
    background-color: #f8f8f8;
    /* 文字色を濃い灰色にします */
    color: #333;
    /* ページの中央にコンテンツを配置するための最大幅を設定 */
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
    padding: 20px;
}


/* ------------------------------------------- */
/* H1 要素のスタイル (主要なタイトル) */
/* ------------------------------------------- */
h1 {
    color: #1a56a0; /* 強調したい青系の色 */
    font-size: 2.5em; /* フォントサイズを大きく設定 */
    border-bottom: 4px solid #1a56a0; /* タイトルの下に太い線を追加 */
    padding-bottom: 10px; /* 下線とテキストの間にスペースを開ける */
    margin-top: 0; /* ページ上端の余白をリセット */
    margin-bottom: 30px; /* H1の下にスペースを大きく開ける */
}


/* ------------------------------------------- */
/* H2 要素のスタイル (セクション見出し) */
/* ------------------------------------------- */
h2 {
    color: #3a75c4; /* H1より少し淡い青系の色 */
    font-size: 1.8em; /* H1より小さいフォントサイズ */
    border-left: 5px solid #3a75c4; /* 左側に区切り線を追加 */
    padding-left: 10px; /* 区切り線とテキストの間にスペースを開ける */
    margin-top: 40px; /* 上部に十分なスペースを開けてセクションの区切りを明確にする */
    margin-bottom: 15px;
}


/* ------------------------------------------- */
/* 段落 (p) のスタイル */
/* ------------------------------------------- */
p {
    margin-bottom: 15px;
}
